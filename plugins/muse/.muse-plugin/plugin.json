{
  "schemaVersion": 1,
  "name": "agent-bridge",
  "displayName": "agent-bridge",
  "version": "0.30.15",
  "description": "Peer messaging, delegation and conversation history across coding agents.",
  "compat": {
    "source": "native",
    "manifestDir": ".muse-plugin"
  },
  "capabilities": {
    "skills": [
      {
        "id": "agent-bridge",
        "path": "skills/agent-bridge/SKILL.md",
        "enabledDefault": true
      }
    ],
    "commands": [
      {
        "id": "peers",
        "path": "commands/peers.md",
        "enabledDefault": true
      },
      {
        "id": "send",
        "path": "commands/send.md",
        "enabledDefault": true
      },
      {
        "id": "inbox",
        "path": "commands/inbox.md",
        "enabledDefault": true
      },
      {
        "id": "dashboard",
        "path": "commands/dashboard.md",
        "enabledDefault": true
      },
      {
        "id": "delegate",
        "path": "commands/delegate.md",
        "enabledDefault": true
      }
    ],
    "hooks": [],
    "mcpServers": [
      {
        "id": "bridge",
        "transport": "stdio",
        "command": [
          "node",
          "dist/server.mjs",
          "--agent=muse"
        ]
      }
    ],
    "reminders": []
  }
}
