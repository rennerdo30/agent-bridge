{
  "name": "agent-bridge",
  "displayName": "agent-bridge",
  "version": "0.32.0",
  "description": "Peer messaging, delegation and conversation history across coding agents (Claude Code, Codex, opencode, Antigravity, Muse). Inside T3 Code it is an add-on: use T3's own tools first.",
  "author": {
    "name": "rennerdo30",
    "url": "https://github.com/rennerdo30"
  },
  "homepage": "https://github.com/rennerdo30/agent-bridge",
  "repository": "https://github.com/rennerdo30/agent-bridge",
  "license": "MIT",
  "keywords": [
    "codex",
    "multi-agent",
    "mcp",
    "channels",
    "collaboration"
  ],
  "mcpServers": {
    "bridge": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/dist/server.mjs",
        "--agent=claude"
      ]
    }
  },
  "channels": [
    {
      "server": "bridge",
      "displayName": "agent-bridge"
    }
  ]
}
