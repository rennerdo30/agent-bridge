  "license": "MIT",
  "keywords": [
    "codex",
    "multi-agent",
    "mcp",
    "channels",
    "collaboration"
  ],
  "mcpServers": {
    "bridge": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/dist/server.mjs",
        "--agent=claude"
      ]
    }
  },
  "channels": [
    {
      "server": "bridge",
      "displayName": "agent-bridge"
    }
  ]
}
