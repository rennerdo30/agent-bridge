{
  "name": "agent-bridge",
  "displayName": "agent-bridge",
  "version": "0.26.0",
  "description": "Talk to OpenAI Codex from Claude Code: live peer messaging over a local pipe, plus headless delegation (ask_codex).",
  "author": {
    "name": "rennerdo30",
    "url": "https://github.com/rennerdo30"
  },
  "homepage": "https://github.com/rennerdo30/agent-bridge",
