{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/cli.mjs",
              "session-start-hook"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:agent-bridge:bridge",
            "tool": "hook_event",
            "input": {
              "event": "UserPromptSubmit",
              "session_id": "${session_id}",
              "cwd": "${cwd}",
              "prompt": "${prompt}",
              "agent_id": "${agent_id}",
              "prompt_id": "${prompt_id}"
            }
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:agent-bridge:bridge",
            "tool": "hook_event",
            "input": {
              "event": "PostToolUse",
              "session_id": "${session_id}",
              "agent_id": "${agent_id}",
              "prompt_id": "${prompt_id}"
            }
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:agent-bridge:bridge",
            "tool": "hook_event",
            "input": {
              "event": "Stop",
              "session_id": "${session_id}",
              "stop_hook_active": "${stop_hook_active}",
              "agent_id": "${agent_id}",
              "prompt_id": "${prompt_id}"
            }
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/cli.mjs",
              "rewake-hook"
            ],
            "async": true,
            "asyncRewake": true,
            "timeout": 7200
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/cli.mjs",
              "rewake-hook",
              "--standby"
            ],
            "async": true,
            "asyncRewake": true,
            "timeout": 7200
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:agent-bridge:bridge",
            "tool": "hook_event",
            "input": {
              "event": "StopFailure",
              "session_id": "${session_id}",
              "agent_id": "${agent_id}",
              "prompt_id": "${prompt_id}"
            }
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:agent-bridge:bridge",
            "tool": "hook_event",
            "input": {
              "event": "SubagentStart",
              "session_id": "${session_id}",
              "agent_id": "${agent_id}"
            }
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:agent-bridge:bridge",
            "tool": "hook_event",
            "input": {
              "event": "SubagentStop",
              "session_id": "${session_id}",
              "agent_id": "${agent_id}"
            }
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:agent-bridge:bridge",
            "tool": "hook_event",
            "input": {
              "event": "SessionEnd",
              "session_id": "${session_id}"
            }
          }
        ]
      }
    ]
  },
  "modules": [
    "./wake.ts",
    "./mail-scope.ts"
  ]
}
