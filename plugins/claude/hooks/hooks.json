{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:agent-bridge:bridge",
            "tool": "hook_event",
            "input": { "event": "SessionStart", "session_id": "${session_id}", "cwd": "${cwd}" }
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:agent-bridge:bridge",
            "tool": "hook_event",
            "input": { "event": "UserPromptSubmit", "session_id": "${session_id}", "cwd": "${cwd}", "prompt": "${prompt}" }
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:agent-bridge:bridge",
            "tool": "hook_event",
            "input": { "event": "PostToolUse", "session_id": "${session_id}", "agent_id": "${agent_id}" }
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:agent-bridge:bridge",
            "tool": "hook_event",
            "input": { "event": "Stop", "session_id": "${session_id}", "stop_hook_active": "${stop_hook_active}" }
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/dist/cli.mjs", "rewake-hook"],
            "async": true,
            "asyncRewake": true,
            "timeout": 7200
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/dist/cli.mjs", "rewake-hook", "--standby"],
            "async": true,
            "asyncRewake": true,
            "timeout": 7200
          }
        ]
      }
    ]
  }
}
