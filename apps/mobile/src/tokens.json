{
  "$schema": "https://agent-bridge.local/mobile/tokens/v1",
  "meta": {
    "name": "agent-bridge mobile",
    "version": 1,
    "source": "src/cli/ui-page.ts :root and dark theme custom properties (the original agent-bridge indigo/blue palette)",
    "notes": [
      "Hex values are copied from the web dashboard unless listed under meta.mobileAdjustments.",
      "Never use a raw hex in components: read color.<theme>.<token>.",
      "Units are density-independent points (RN numbers). Font sizes are scaled by the OS text size; see typography.maxFontSizeMultiplier."
    ],
    "mobileAdjustments": {
      "textFaint": "Dashboard --faint (#949bab light, #7d8699 dark) fails WCAG AA for text (2.79:1 / 4.56:1). Mobile uses faint only for icons, rules and disabled glyphs, and textFaint (#666e80 light 4.69:1 on bg, #8f98ab dark 5.75:1 on panel) for tertiary text.",
      "accentFill": "Dashboard dark buttons put white on #7c8cff (2.98:1). Mobile fills primary buttons with accentFill (#4f46e5 light 6.29:1, #4f5bd5 dark 5.54:1) and keeps accent for text, icons, borders and selection.",
      "agent avatars": "White initials on agent colors are 2.7-3.7:1. Avatars are decorative (accessible={false}); the agent name is always also present as text."
    }
  },
  "color": {
    "light": {
      "bg": "#f4f5f7",
      "panel": "#ffffff",
      "panel2": "#f8f9fb",
      "sunk": "#eceef2",
      "line": "#e4e7ec",
      "text": "#161b26",
      "textMuted": "#5f6779",
      "textFaint": "#666e80",
      "faint": "#949bab",
      "accent": "#4f46e5",
      "accentSoft": "#eef0ff",
      "accentFill": "#4f46e5",
      "onAccent": "#ffffff",
      "ok": "#15803d",
      "okSoft": "#e8f6ed",
      "warn": "#b45309",
      "warnSoft": "#fdf3e2",
      "bad": "#c2410c",
      "badSoft": "#fdeee6",
      "onStatusFill": "#ffffff",
      "codeBg": "#f8f9fb",
      "inlineCodeBg": "rgba(127,127,127,0.15)",
      "scrim": "rgba(16,24,40,0.40)",
      "focusRing": "#4f46e5",
      "skeleton": "#eceef2",
      "skeletonHighlight": "#f8f9fb"
    },
    "dark": {
      "bg": "#121722",
      "panel": "#181e2b",
      "panel2": "#1e2533",
      "sunk": "#0e121b",
      "line": "#2a3243",
      "text": "#eceef3",
      "textMuted": "#aab2c2",
      "textFaint": "#8f98ab",
      "faint": "#7d8699",
      "accent": "#7c8cff",
      "accentSoft": "#252d4c",
      "accentFill": "#4f5bd5",
      "onAccent": "#ffffff",
      "ok": "#4ade80",
      "okSoft": "#173524",
      "warn": "#fbbf24",
      "warnSoft": "#3a2e12",
      "bad": "#fb923c",
      "badSoft": "#40241a",
      "onStatusFill": "#0e121b",
      "codeBg": "#1e2533",
      "inlineCodeBg": "rgba(127,127,127,0.15)",
      "scrim": "rgba(0,0,0,0.55)",
      "focusRing": "#7c8cff",
      "skeleton": "#1e2533",
      "skeletonHighlight": "#2a3243"
    }
  },
  "agent": {
    "claude": "#d97757",
    "codex": "#0f9d76",
    "opencode": "#3b82f6",
    "antigravity": "#a78bfa",
    "muse": "#f472b6",
    "other": "#8b93a5",
    "initialColor": "#ffffff",
    "initials": "First letter of the agent kind, uppercased, as the dashboard av() helper does (claude C, codex C, opencode O, antigravity A, muse M); '?' when unknown.",
    "notes": "Same hex in light and dark, exactly as the dashboard. Color, not the letter, tells Claude and Codex apart; the agent name is always also written as text."
  },
  "status": {
    "notes": "Every status is shown as color + text (+ dot shape where listed). Values reference color.<theme> keys.",
    "busy":        { "fg": "accent",    "bg": "accentSoft", "dot": "accent",    "ring": "accentSoft", "label": "busy",        "pulse": true },
    "idle":        { "fg": "ok",        "bg": "okSoft",     "dot": "ok",        "ring": null,         "label": "idle",        "pulse": false },
    "connected":   { "fg": "textMuted", "bg": "panel2",     "dot": "ok",        "ring": null,         "label": "connected",   "pulse": false },
    "offline":     { "fg": "textFaint", "bg": "panel2",     "dot": "faint",     "ring": null,         "label": "offline",     "pulse": false, "dotStyle": "hollow" },
    "unavailable": { "fg": "warn",      "bg": "warnSoft",   "dot": "warn",      "ring": null,         "label": "unavailable", "pulse": false },
    "ended":       { "fg": "textFaint", "bg": "panel2",     "dot": "faint",     "ring": null,         "label": "ended",       "pulse": false, "dotStyle": "hollow", "rowOpacity": 0.6 },
    "running":     { "fg": "accent",    "bg": "accentSoft", "dot": "accent",    "ring": "accentSoft", "label": "working",     "pulse": true },
    "done":        { "fg": "ok",        "bg": "okSoft",     "dot": "ok",        "ring": null,         "label": "done",        "pulse": false },
    "failed":      { "fg": "bad",       "bg": "badSoft",    "dot": "bad",       "ring": null,         "label": "failed",      "pulse": false },
    "interrupted": { "fg": "warn",      "bg": "warnSoft",   "dot": "warn",      "ring": null,         "label": "interrupted", "pulse": false },
    "cancelled":   { "fg": "warn",      "bg": "warnSoft",   "dot": "warn",      "ring": null,         "label": "cancelled",   "pulse": false },
    "unknown":     { "fg": "textFaint", "bg": "panel2",     "dot": "faint",     "ring": null,         "label": "unknown",     "pulse": false },
    "attention":   { "fg": "warn",      "bg": "warnSoft",   "dot": "warn",      "ring": null,         "label": "waiting for you", "pulse": false },
    "questionOpen":      { "fg": "accent", "bg": "accentSoft", "label": "open" },
    "questionAnswered":  { "fg": "ok",     "bg": "okSoft",     "label": "answered" },
    "questionCancelled": { "fg": "textMuted", "bg": "panel2",  "label": "cancelled" },
    "questionSuperseded":{ "fg": "textMuted", "bg": "panel2",  "label": "superseded" },
    "urgent":      { "fg": "bad",  "bg": "badSoft",  "label": "urgent" },
    "blocking":    { "fg": "warn", "bg": "warnSoft", "label": "blocking" },
    "permission":  { "low": { "fg": "ok", "bg": "okSoft" }, "mid": { "fg": "warn", "bg": "warnSoft" }, "high": { "fg": "bad", "bg": "badSoft" } },
    "outcome":     { "ok": { "fg": "ok", "bg": "okSoft" }, "warn": { "fg": "warn", "bg": "warnSoft" }, "faint": { "fg": "textFaint", "bg": "panel2" } }
  },
  "spacing": {
    "0": 0, "0.5": 2, "1": 4, "1.5": 6, "2": 8, "2.5": 10, "3": 12, "3.5": 14, "4": 16, "5": 20, "6": 24, "7": 28, "8": 32, "10": 40, "12": 48,
    "alias": {
      "screenGutter": 16,
      "cardPadding": 16,
      "rowPaddingV": 12,
      "rowPaddingH": 16,
      "rowGap": 12,
      "sectionGap": 24,
      "inlineGap": 8,
      "chipGap": 6,
      "chatPaddingH": 12,
      "chatItemGap": 12,
      "bubblePaddingV": 10,
      "bubblePaddingH": 14,
      "stepIndent": 12,
      "stepPaddingLeft": 16
    }
  },
  "radius": {
    "none": 0,
    "xs": 4,
    "chip": 5,
    "pill": 6,
    "avatarSm": 6,
    "button": 8,
    "avatar": 8,
    "input": 10,
    "card": 10,
    "panel": 12,
    "bubble": 14,
    "bubbleTail": 4,
    "sheet": 16,
    "round": 999
  },
  "typography": {
    "family": {
      "sans": { "ios": "System", "android": "sans-serif", "notes": "SF Pro Text on iOS, Roboto on Android. The dashboard stack ends in system-ui; do not bundle a font." },
      "mono": { "ios": "Menlo", "android": "monospace" }
    },
    "weights": { "regular": "400", "medium": "500", "semibold": "600", "bold": "700" },
    "scale": {
      "largeTitle": { "size": 28, "lineHeight": 34, "weight": "700", "letterSpacing": -0.4, "maxFontSizeMultiplier": 1.6 },
      "title":      { "size": 20, "lineHeight": 26, "weight": "600", "letterSpacing": -0.3, "maxFontSizeMultiplier": 1.8 },
      "headline":   { "size": 17, "lineHeight": 22, "weight": "600", "letterSpacing": -0.2, "maxFontSizeMultiplier": 2.0 },
      "body":       { "size": 15, "lineHeight": 22, "weight": "400", "letterSpacing": 0,    "maxFontSizeMultiplier": 2.0 },
      "bodyStrong": { "size": 15, "lineHeight": 22, "weight": "600", "letterSpacing": 0,    "maxFontSizeMultiplier": 2.0 },
      "chat":       { "size": 15, "lineHeight": 23, "weight": "400", "letterSpacing": 0,    "maxFontSizeMultiplier": 2.0 },
      "callout":    { "size": 14, "lineHeight": 20, "weight": "400", "letterSpacing": 0,    "maxFontSizeMultiplier": 2.0 },
      "subhead":    { "size": 13, "lineHeight": 18, "weight": "400", "letterSpacing": 0,    "maxFontSizeMultiplier": 2.0 },
      "subheadStrong": { "size": 13, "lineHeight": 18, "weight": "600", "letterSpacing": 0, "maxFontSizeMultiplier": 2.0 },
      "caption":    { "size": 12, "lineHeight": 16, "weight": "500", "letterSpacing": 0,    "maxFontSizeMultiplier": 1.6 },
      "micro":      { "size": 11, "lineHeight": 14, "weight": "600", "letterSpacing": 0.2,  "maxFontSizeMultiplier": 1.4 },
      "overline":   { "size": 12, "lineHeight": 16, "weight": "600", "letterSpacing": 0.5,  "maxFontSizeMultiplier": 1.6, "textTransform": "uppercase" },
      "stat":       { "size": 26, "lineHeight": 30, "weight": "600", "letterSpacing": -0.5, "maxFontSizeMultiplier": 1.4, "fontVariant": ["tabular-nums"] },
      "mono":       { "size": 13, "lineHeight": 19, "weight": "400", "letterSpacing": 0,    "maxFontSizeMultiplier": 1.8, "family": "mono" },
      "monoSmall":  { "size": 12, "lineHeight": 17, "weight": "400", "letterSpacing": 0,    "maxFontSizeMultiplier": 1.6, "family": "mono" },
      "time":       { "size": 11, "lineHeight": 14, "weight": "400", "letterSpacing": 0,    "maxFontSizeMultiplier": 1.4, "fontVariant": ["tabular-nums"] }
    },
    "roles": {
      "screenTitle": "largeTitle (collapses to headline in the nav bar on scroll)",
      "sectionHeader": "subheadStrong, color textMuted",
      "hostHeader": "overline, color textMuted",
      "rowTitle": "bodyStrong, color text",
      "rowSubtitle": "subhead, color textMuted",
      "rowMeta": "caption, color textFaint",
      "chipText": "micro (not uppercase), color per variant",
      "pillText": "caption weight 600",
      "bubbleWho": "caption weight 600, color textMuted",
      "stepTool": "micro weight 600, color accent",
      "stepSummary": "monoSmall, color textMuted, 1 line ellipsized",
      "questionKind": "overline, color accent",
      "questionTitle": "title"
    }
  },
  "elevation": {
    "notes": "The dashboard separates surfaces by tone, not shadow. Only sheets, toasts and the floating jump button lift.",
    "light": {
      "0": { "shadowColor": "#101828", "shadowOpacity": 0,    "shadowRadius": 0,  "shadowOffset": { "width": 0, "height": 0 },  "androidElevation": 0 },
      "1": { "shadowColor": "#101828", "shadowOpacity": 0.05, "shadowRadius": 2,  "shadowOffset": { "width": 0, "height": 1 },  "androidElevation": 1 },
      "2": { "shadowColor": "#101828", "shadowOpacity": 0.16, "shadowRadius": 20, "shadowOffset": { "width": 0, "height": 16 }, "androidElevation": 8 }
    },
    "dark": {
      "0": { "shadowColor": "#000000", "shadowOpacity": 0,    "shadowRadius": 0,  "shadowOffset": { "width": 0, "height": 0 },  "androidElevation": 0 },
      "1": { "shadowColor": "#000000", "shadowOpacity": 0,    "shadowRadius": 0,  "shadowOffset": { "width": 0, "height": 0 },  "androidElevation": 0 },
      "2": { "shadowColor": "#000000", "shadowOpacity": 0.5,  "shadowRadius": 24, "shadowOffset": { "width": 0, "height": 18 }, "androidElevation": 12 }
    },
    "use": { "card": "1", "sheet": "2", "toast": "2", "jumpToLatest": "2", "tabBar": "0 with a top hairline in line" }
  },
  "border": {
    "hairline": "StyleSheet.hairlineWidth",
    "default": 1,
    "selected": 1.5,
    "treeGuide": 1.5,
    "answerAccent": 3
  },
  "size": {
    "touchTargetMin": { "ios": 44, "android": 48 },
    "avatar": 34,
    "avatarSm": 24,
    "avatarInitialSize": 14,
    "avatarSmInitialSize": 11.5,
    "dot": 8,
    "dotRing": 3,
    "progressBarHeight": 3,
    "progressBarHeightLarge": 5,
    "tabBarIcon": 24,
    "badgeMinWidth": 18,
    "badgeHeight": 18,
    "chatMaxBubbleWidthRatio": 0.88,
    "userBubbleClampHeight": 220,
    "userBubbleClampChars": 600,
    "qrFrame": 248,
    "buttonHeight": 48,
    "inputMinHeight": 44,
    "composerMaxLines": 6
  },
  "opacity": {
    "disabled": 0.6,
    "ended": 0.6,
    "pressed": 0.7,
    "staleContent": 1.0
  },
  "motion": {
    "notes": "All animations are skipped when AccessibilityInfo.isReduceMotionEnabled() is true.",
    "pulse": { "durationMs": 1400, "minOpacity": 0.35, "loop": true },
    "progressWidth": { "durationMs": 400, "easing": "ease-out" },
    "pressFeedbackMs": 120,
    "sheetSpring": { "damping": 22, "stiffness": 220 },
    "toastVisibleMs": 4000,
    "skeletonShimmerMs": 1200
  },
  "timing": {
    "notes": "Behavioural constants the screens refer to (DESIGN.md section 9).",
    "pollStateMs": 3000,
    "pollQuestionsMs": 5000,
    "pollChatBusyMs": 2000,
    "pollChatIdleMs": 6000,
    "requestTimeoutMs": 10000,
    "answerTimeoutMs": 15000,
    "staleAfterMs": 15000,
    "reconnectBackoffMs": [1000, 2000, 4000, 8000, 15000],
    "unreachableAfterFailures": 3,
    "pairingQrTtlMs": 300000,
    "pairingConfirmTimeoutMs": 120000,
    "etaHourFromMinutes": 90,
    "foldStepsOver": 3,
    "maxChatItems": 3000
  }
}
