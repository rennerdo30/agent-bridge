+
+it("revocation during admission never retargets the old call", async () => {
+  const admission = deferred<boolean>(), entered = deferred<void>();
+  const f = fixture("A", { admitMain: async () => { entered.resolve(); return admission.promise; } });
+  f.bind("native-A");
+  const pending = f.session.dispatch(call(), active(), signal());
+  await entered.promise; await f.session.close();
+  assert.throws(() => f.session.bindStartedRoot("native-B"));
+  const replacement = fixture(); replacement.bind("native-A");
+  admission.resolve(true);
+  assert.equal((await pending).success, false);
+  assert.equal(f.effects.length + replacement.effects.length, 0);
+});
+
+it("suppresses private results revoked after submission and never retries the call", async () => {
+  const result = deferred<Call["arguments"]>(), entered = deferred<void>();
+  let submissions = 0;
+  const f = fixture("A", { pending: async () => { submissions++; entered.resolve(); return result.promise; } });
+  f.bind("native-A");
+  const pending = f.session.dispatch(call(), active(), signal());
+  await entered.promise; f.revokePort(); result.resolve({ private: "mock-only" });
+  const reply = await pending;
+  assert.equal(reply.success, false); assert.equal(JSON.stringify(reply).includes("mock-only"), false);
+  assert.equal((await f.session.dispatch(call(), active(), signal())).success, false);
+  assert.equal(submissions, 1);
+});
+
+it("resumed persisted definitions do not reconstruct an untrusted root binding", async () => {
+  const f = fixture();
+  assert.equal((await f.session.dispatch(call(), active(), signal())).success, false);
+  assert.equal(f.effects.length, 0);
+});
+
+it("identical replay preserves settlement and cancelled new requests produce no repeated effect", async () => {
+  const f = fixture(); f.bind("native-A");
+  assert.equal((await f.session.dispatch(call(), active(), signal())).success, true);
+  assert.equal((await f.session.dispatch(call(), active(), signal())).success, true);
+  const abort = new AbortController(); abort.abort();
+  assert.equal((await f.session.dispatch(call({ callId: "other" }), active(), abort.signal)).success, false);
+  assert.equal(f.effects.length, 1);
+});
