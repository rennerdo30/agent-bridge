@@ -0,0 +1,49 @@
+import { it } from "@effect/vitest";
+import assert from "node:assert/strict";
+import { makePrivateRequestAdmission } from "./PrivateRequestAdmission.ts";
+const request = (id: string | number, params: unknown = { threadId: "root", turnId: "turn", callId: "call", arguments: { a: "x", b: "y" } }) => ({ id, method: "item/tool/call", params });
+it("32 active admission tickets deduplicate before overload without allocating another handler", () => {
+  const gate = makePrivateRequestAdmission();
+  const tickets = Array.from({ length: 32 }, (_, id) => gate.admit(request(id)));
+  assert.equal(tickets.every((ticket) => ticket.kind === "accepted"), true);
+  for (let i = 0; i < 64; i++) assert.equal(gate.admit(request(0)).kind, "replay");
+  assert.deepEqual(gate.size(), { active: 32, records: 32 });
+  assert.equal(gate.admit(request(33)).kind, "overloaded");
+  assert.equal(gate.admit(request(33)).kind, "replay");
+  assert.deepEqual(gate.size(), { active: 32, records: 33 });
+});
+it("same ID with changed method/params conflicts without releasing original admission", () => {
+  const gate = makePrivateRequestAdmission();
+  const original = gate.admit(request("same")); assert.equal(original.kind, "accepted");
+  assert.equal(gate.admit({ ...request("same"), method: "other" }).kind, "conflict");
+  assert.equal(gate.admit(request("same", { threadId: "child" })).kind, "conflict");
+  assert.deepEqual(gate.size(), { active: 1, records: 1 });
+  if (original.kind === "accepted") gate.finish(original.ticket);
+  assert.equal(gate.admit(request("same")).kind, "replay");
+  assert.deepEqual(gate.size(), { active: 0, records: 1 });
+});
+it("canonical key order coalesces but distinct JSON values and ID types do not alias", () => {
+  const gate = makePrivateRequestAdmission();
+  gate.admit(request(1, { a: "a", b: ["b", "c"] }));
+  assert.equal(gate.admit(request(1, { b: ["b", "c"], a: "a" })).kind, "replay");
+  assert.equal(gate.admit(request(1, { a: "a", b: ["c", "b"] })).kind, "conflict");
+  assert.equal(gate.admit(request("1")).kind, "accepted");
+  gate.admit({ id: 2, method: "item/tool/call" });
+  assert.equal(gate.admit({ id: 2, method: "item/tool/call", params: null }).kind, "conflict");
+});
+it("timeout/cancellation settlement is tombstoned; shutdown isolates replacement generation", () => {
+  const old = makePrivateRequestAdmission(); const entry = old.admit(request(1));
+  if (entry.kind !== "accepted") throw new Error("expected acceptance");
+  old.finish(entry.ticket); old.finish(entry.ticket);
+  assert.equal(old.admit(request(1)).kind, "replay");
+  old.close(); assert.equal(old.admit(request(1)).kind, "closed");
+  const replacement = makePrivateRequestAdmission(); replacement.admit(request(1));
+  old.finish(entry.ticket); assert.deepEqual(replacement.size(), { active: 1, records: 1 });
+});
+it("record exhaustion is explicit and never evicts a call into re-execution", () => {
+  const gate = makePrivateRequestAdmission(1, 2);
+  gate.admit(request(1)); gate.admit(request(2));
+  assert.equal(gate.admit(request(3)).kind, "exhausted");
+  assert.equal(gate.admit(request(1)).kind, "replay");
+  assert.deepEqual(gate.size(), { active: 1, records: 2 });
+});
