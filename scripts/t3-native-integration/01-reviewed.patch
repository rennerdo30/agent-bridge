+import { bridgeDynamicTools, makeBridgeDynamicSession, type BridgeActiveRoot, type BridgeMessagingPort, type BridgeRootLease } from "./CodexBridgeDynamicTools.ts";
+
+type Call = CodexRpc.ServerRequestParamsByMethod["item/tool/call"];
+type Reply = CodexRpc.ServerRequestResponsesByMethod["item/tool/call"];
+const signal = () => new AbortController().signal;
+const call = (overrides: Partial<Call> = {}): Call => ({
+  threadId: "native-A", turnId: "turn-A", callId: "call-A", namespace: "agent_bridge",
+  tool: "pending", arguments: {}, ...overrides,
+});
+const active = (overrides: Partial<BridgeActiveRoot> = {}): BridgeActiveRoot => ({
+  appThreadId: "app-A", nativeThreadId: "native-A", nativeTurnId: "turn-A",
+  isChild: false, isCurrent: async () => true, ...overrides,
+});
+function deferred<T>() {
+  let resolve!: (value: T) => void;
+  const promise = new Promise<T>((r) => { resolve = r; });
+  return { promise, resolve };
+}
+function fixture(app = "A", overrides: Partial<BridgeMessagingPort> = {}) {
+  let live = true;
+  const effects: BridgeRootLease[] = [];
+  const effect: BridgeMessagingPort["pending"] = async (lease, guard, abort) => {
+    assert.equal(abort.aborted, false);
+    if (!await guard()) throw new Error("revoked before effect");
+    effects.push(lease);
+    return { owner: lease.appThreadId };
+  };
+  const port: BridgeMessagingPort = {
+    isLive: () => live, admitMain: async () => true,
+    peers: effect, pending: effect, readMessage: (lease, _args, guard, abort) => effect(lease, guard, abort),
+    send: (lease, _args, guard, abort) => effect(lease, guard, abort),
+    sendStatus: (lease, _args, guard, abort) => effect(lease, guard, abort),
+    close: async () => { live = false; },
+    ...overrides,
+  };
+  const scope = { appThreadId: `app-${app}`, providerInstanceId: "provider", providerSessionId: `session-${app}` };
+  const session = makeBridgeDynamicSession(scope, port);
+  const bind = (id: string) => { assert.equal(session.reserveStart(), true); session.bindStartedRoot(id); };
+  return { scope, port, session, effects, bind, revokePort: () => { live = false; } };
+}
+
+it("registers actual experimental protocol specs only on the raw start path", async () => {
+  const payload: CodexSchema.V2ThreadStartParams & {
+    dynamicTools: ReadonlyArray<CodexSchema.ClientRequest__DynamicToolSpec>;
+  } = { dynamicTools: bridgeDynamicTools };
+  const requests: unknown[] = [];
+  const raw = { request: async (method: "thread/start", params: typeof payload) => {
+    requests.push({ method, params }); return { thread: { id: "native-A" } };
+  } };
+  const f = fixture();
+  const response = await raw.request("thread/start", payload);
+  f.bind(response.thread.id);
+  assert.equal(requests.length, 1);
+  const namespace = payload.dynamicTools[0]!;
+  assert.equal(namespace.type, "namespace");
+  if (namespace.type !== "namespace") throw new Error("expected namespace");
+  assert.deepEqual(namespace.tools.map((tool) => tool.name), ["peers", "pending", "read_message", "send", "send_status"]);
+  assert.equal(JSON.stringify(payload).includes("http_headers"), false);
+});
+
+it("dispatches the actual typed item/tool/call response under its original private request ID", async () => {
+  const f = fixture(); f.bind("native-A");
+  const handlers = new Map<string, (payload: Call) => Promise<Reply>>();
+  const handleServerRequest = (method: "item/tool/call", handler: (payload: Call) => Promise<Reply>) => handlers.set(method, handler);
+  handleServerRequest("item/tool/call", (payload) => f.session.dispatch(payload, active(), signal()));
+  const request = { id: "rpc-123", method: "item/tool/call", params: call() };
