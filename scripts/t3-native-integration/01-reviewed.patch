@@ -0,0 +1,233 @@
+// CI only: production adapter -> real client -> patched private protocol.
+// No test installs an item/tool/call handler or registers dynamicTools itself.
+import { assert, it } from "@effect/vitest";
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import { CodexSettings, ThreadId, ProviderSessionId, ProjectId, RunAttemptId, RunId, NodeId, MessageId, type OrchestrationV2AppThread, type OrchestrationV2ProviderThread } from "@t3tools/contracts";
+import * as IdAllocator from "@t3tools/provider-core/server/IdAllocator";
+import * as McpProviderSessions from "@t3tools/provider-core/server/McpProviderSessions";
+import * as ProviderAdapter from "@t3tools/provider-core/server/ProviderAdapter";
+import * as Client from "effect-codex-app-server/client";
+import type * as Protocol from "effect-codex-app-server/schema";
+import type { CodexAppServerProtocolLogEvent } from "effect-codex-app-server/protocol";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Queue from "effect/Queue";
+import * as Stream from "effect/Stream";
+import * as Scope from "effect/Scope";
+import * as Exit from "effect/Exit";
+import * as Fiber from "effect/Fiber";
+import * as Crypto from "effect/Crypto";
+import * as FileSystem from "effect/FileSystem";
+import * as DateTime from "effect/DateTime";
+import * as Schema from "effect/Schema";
+import { makeInMemoryStdio } from "../../../../../packages/effect-codex-app-server/src/_internal/stdio.ts";
+import * as Adapter from "./CodexAdapterV2.ts";
+import { makeReplayServerConfig } from "./CodexAdapterV2.testkit.ts";
+import { bridgeDynamicTools, type BridgeMessagingPort } from "./CodexBridgeDynamicTools.ts";
+
+function latch<T>() {
+  let resolve!: (value: T) => void;
+  let reject!: (error: Error) => void;
+  const promise = new Promise<T>((yes, no) => { resolve = yes; reject = no; });
+  return { promise, resolve, reject };
+}
+const encode = (value: unknown) => new TextEncoder().encode(`${JSON.stringify(value)}\n`);
+const rootId = "ab458-root", rootTurn = "ab458-turn";
+const policy = ProviderAdapter.ProviderAdapterV2RuntimePolicy.make({ runtimeMode: "full-access", interactionMode: "default", cwd: "/workspace" });
+const selection = { instanceId: Adapter.CODEX_DEFAULT_INSTANCE_ID, model: "gpt-5.4" };
+const threadReply: Protocol.V2ThreadStartResponse = {
+  approvalPolicy: "never", approvalsReviewer: "user", cwd: "/workspace", model: "gpt-5.4", modelProvider: "mock",
+  sandbox: { type: "readOnly" }, thread: {
+    cliVersion: "mock", createdAt: 1, updatedAt: 1, cwd: "/workspace", ephemeral: false,
+    id: rootId, modelProvider: "mock", preview: "", projectId: null, sessionId: "mock-session",
+    source: "appServer", status: { type: "idle" }, turns: [],
+  },
+};
+const turn = (id: string) => ({ id, items: [], itemsView: "notLoaded", status: "inProgress", error: null, startedAt: 1, completedAt: null, durationMs: null });
+
+// Same actual contract shape as pinned upstream makeCodexTestTurnInput; these
+// are mocked app records, not substitutes for production adapter state.
+function turnInput(threadId: ThreadId, providerThread: OrchestrationV2ProviderThread, now: DateTime.Utc): ProviderAdapter.ProviderAdapterV2TurnInput {
+  const appThread: OrchestrationV2AppThread = {
+    createdBy: "user", creationSource: "web", id: threadId, projectId: ProjectId.make("ab458-project"), title: "AB458",
+    providerInstanceId: Adapter.CODEX_DEFAULT_INSTANCE_ID, modelSelection: selection,
+    runtimeMode: "full-access", interactionMode: "default", branch: null, worktreePath: null,
+    activeProviderThreadId: providerThread.id,
+    lineage: { parentThreadId: null, relationshipToParent: null, rootThreadId: threadId }, forkedFrom: null,
+    createdAt: now, updatedAt: now, archivedAt: null, settledOverride: null, settledAt: null, lastVisitedAt: null, deletedAt: null,
+  };
+  return {
+    appThread, threadId, providerThread, runId: RunId.make("ab458-run"), runOrdinal: 1, providerTurnOrdinal: 1,
+    attemptId: RunAttemptId.make("ab458-attempt"), rootNodeId: NodeId.make("ab458-node"),
+    message: { createdBy: "user", creationSource: "web", messageId: MessageId.make("ab458-message"), text: "mock", attachments: [] },
+    modelSelection: selection, runtimePolicy: policy,
+  };
+}
+
+const makeHarness = Effect.fnUntraced(function* (scope: Scope.Scope) {
+  const pipe = yield* makeInMemoryStdio();
+  const outgoing: Array<Record<string, unknown>> = [];
+  const markers = new Map<string, ReturnType<typeof latch<void>>>();
+  const replyWaiters = new Map<number, { readonly count: number; readonly ready: ReturnType<typeof latch<void>> }>();
+  let closed = 0, sends = 0, phase: "hold" | "fault" | "shutdown" = "hold";
+  const allStarted = latch<void>(), release = latch<Protocol.DynamicToolCallParams["arguments"]>();
+  const prematureReply = latch<void>();
+  const faultEntered = latch<void>(), fault = latch<Protocol.DynamicToolCallParams["arguments"]>();
+  const shutdownEntered = latch<void>(), closeEntered = latch<void>(), releaseClose = latch<void>();
+  const hanging = latch<Protocol.DynamicToolCallParams["arguments"]>();
+  const nativeTurns = new Set<string>();
+  const turnWaiters = new Map<string, ReturnType<typeof latch<void>>>();
+  const logger = (event: CodexAppServerProtocolLogEvent) => Effect.sync(() => {
+    if (event.stage !== "decoded" || !event.payload || typeof event.payload !== "object") return;
+    const frame = event.payload as Record<string, unknown>;
+    if (event.direction === "outgoing") {
+      outgoing.push(frame);
+      if (typeof frame.id === "number" && !frame.method) {
+        if (frame.id >= 100 && frame.id < 132) prematureReply.resolve();
+        const pending = replyWaiters.get(frame.id);
+        if (pending && outgoing.filter((candidate) => candidate.id === frame.id && !candidate.method).length >= pending.count) {
+          pending.ready.resolve(); replyWaiters.delete(frame.id);
+        }
+      }
+    }
+    if (event.direction === "incoming" && frame.method === "ab458/barrier") {
+      const nonce = (frame.params as Record<string, unknown>).nonce;
+      if (typeof nonce === "string") markers.get(nonce)?.resolve();
+    }
+  });
+  const client = yield* Client.make(pipe.stdio, { logIncoming: true, logOutgoing: true, logger });
+  yield* Stream.fromQueue(pipe.output).pipe(Stream.runForEach((line) => Effect.gen(function* () {
+    const frame = JSON.parse(line) as Record<string, unknown>;
+    if (typeof frame.method !== "string") return; // Actual encoded server-request responses are observed by logger.
+    if (frame.method === "initialized") return;
+    let result: unknown;
+    switch (frame.method) {
+      case "initialize": result = { userAgent: "mock", codexHome: "/mock", platformFamily: "unix", platformOs: "linux" }; break;
+      case "thread/start": result = threadReply; break;
+      case "thread/resume": {
+        const id = (frame.params as Record<string, unknown>).threadId;
+        result = id === rootId ? threadReply : { thread: { id }, model: null }; break;
+      }
+      case "thread/read": result = { thread: { id: (frame.params as Record<string, unknown>).threadId }, model: null }; break;
+      case "turn/start": result = { turn: turn(rootTurn) }; break;
+      default: return yield* Effect.die(`Unexpected mocked outbound method ${frame.method}`);
+    }
+    yield* Queue.offer(pipe.input, encode({ id: frame.id, result }));
+  })), Effect.forkScoped);
+  const port: BridgeMessagingPort = {
+    isLive: () => closed === 0, admitMain: async () => true,
+    peers: async () => [], pending: async () => [], readMessage: async () => ({}), sendStatus: async () => ({}),
+    send: async (_lease, _args, guard, signal) => {
+      assert.equal(await guard(), true); assert.equal(signal.aborted, false); sends++;
+      if (phase === "fault") { faultEntered.resolve(); return fault.promise; }
+      if (phase === "shutdown") { shutdownEntered.resolve(); return hanging.promise; }
+      if (sends === 32) allStarted.resolve();
+      return release.promise;
+    },
+    close: async (signal) => { closed++; assert.equal(signal.aborted, false); closeEntered.resolve(); return releaseClose.promise; },
+  };
+  const adapter = yield* Adapter.makeCodexAdapterV2({
+    instanceId: Adapter.CODEX_DEFAULT_INSTANCE_ID, settings: Schema.decodeSync(CodexSettings)({}), environment: {},
+    clientFactory: { open: () => Effect.succeed(client) }, openBridgeMessaging: () => port,
+    crypto: yield* Crypto.Crypto, fileSystem: yield* FileSystem.FileSystem,
+    idAllocator: yield* IdAllocator.IdAllocatorV2,
+    serverConfig: yield* makeReplayServerConfig("ab458-production-admission").pipe(Effect.orDie),
+  });
+  const appId = ThreadId.make("app-ab458");
+  const runtime = yield* adapter.openSession({ threadId: appId, providerSessionId: ProviderSessionId.make("session-ab458"), modelSelection: selection, runtimePolicy: policy });
+  const providerThread = yield* runtime.ensureThread({ threadId: appId, modelSelection: selection, runtimePolicy: policy });
+  const events: Array<ProviderAdapter.ProviderAdapterV2Event> = [];
+  yield* runtime.events.pipe(Stream.runForEach((event) => Effect.sync(() => {
+    events.push(event);
+    if (event.type === "provider_turn.updated") {
+      const id = event.providerTurn.nativeTurnRef?.nativeId;
+      if (id) { nativeTurns.add(id); turnWaiters.get(id)?.resolve(); }
+    }
+  })), Effect.forkScoped);
+  const start = outgoing.find((frame) => frame.method === "thread/start");
+  assert.deepEqual((start?.params as Record<string, unknown>).dynamicTools, bridgeDynamicTools);
+  yield* runtime.startTurn(turnInput(appId, providerThread, yield* DateTime.now));
+  const waitTurn = (id: string) => Effect.promise(() => {
+    if (nativeTurns.has(id)) return Promise.resolve();
+    const waiter = latch<void>(); turnWaiters.set(id, waiter); return waiter.promise;
+  });
+  yield* waitTurn(rootTurn);
+  let nonce = 0;
+  const barrier = Effect.fnUntraced(function* () {
+    const key = String(++nonce), pending = latch<void>(); markers.set(key, pending);
+    yield* Queue.offer(pipe.input, encode({ method: "ab458/barrier", params: { nonce: key } }));
+    yield* Effect.promise(() => pending.promise); markers.delete(key);
+  });
+  const emit = (value: unknown) => Queue.offer(pipe.input, encode(value));
+  const replies = (id: number) => outgoing.filter((frame) => frame.id === id && !frame.method);
+  const waitReplies = (id: number, count: number) => Effect.promise(() => {
+    if (replies(id).length >= count) return Promise.resolve();
+    const ready = latch<void>(); replyWaiters.set(id, { count, ready }); return ready.promise;
+  });
+  return { scope, runtime, providerThread, appId, emit, barrier, replies, waitReplies, waitTurn, events,
+    sends: () => sends, closed: () => closed, allStarted, prematureReply, release, faultEntered, fault, shutdownEntered,
+    closeEntered, releaseClose, hanging, phase: (next: "hold" | "fault" | "shutdown") => { phase = next; } };
+});
+
+const rpc = (id: number, changes: Partial<Protocol.DynamicToolCallParams> = {}) => ({ id, method: "item/tool/call", params: {
+  threadId: rootId, turnId: rootTurn, callId: `call-${id}`, namespace: "agent_bridge", tool: "send",
+  arguments: { messageId: `m-${id}`, recipientRef: "peer", text: "mock" }, ...changes,
+} satisfies Protocol.DynamicToolCallParams });
+const services = Layer.mergeAll(NodeServices.layer, IdAllocator.layer, McpProviderSessions.layer);
+
+it.effect("AB458 production admission: actual adapter registration, 32-limit warm replay, roots, fault and close", () =>
+  Effect.gen(function* () {
+    const scope = yield* Scope.make();
+    yield* Effect.addFinalizer(() => Scope.close(scope, Exit.void));
+    const h = yield* makeHarness(scope).pipe(Effect.provideService(Scope.Scope, scope));
+    for (let id = 100; id < 132; id++) yield* h.emit(rpc(id));
+    const admitted = yield* Effect.promise(() => Promise.race([
+      h.allStarted.promise.then(() => true), h.prematureReply.promise.then(() => false),
+    ]));
+    assert.equal(admitted, true, "production handler must reach 32 suspended effects before replying");
+    // Actual adapter warm resume while the 32 original effects remain suspended.
+    yield* h.runtime.resumeThread({ threadId: h.appId, providerThread: h.providerThread });
+    for (let id = 100; id < 132; id++) yield* h.emit(rpc(id));
+    yield* h.emit(rpc(100, { arguments: { messageId: "changed", recipientRef: "peer", text: "conflict" } }));
+    yield* h.emit({ ...rpc(100), method: "other/method" });
+    yield* h.emit(rpc(999)); yield* h.barrier();
+    assert.equal(h.sends(), 32);
+    for (let id = 100; id < 132; id++) assert.equal(h.replies(id).length, 0);
+    assert.equal(h.replies(999).length, 1); assert.notEqual(h.replies(999)[0]!.error, undefined);
+    h.release.resolve({ accepted: "mock" });
+    for (let id = 100; id < 132; id++) { yield* h.waitReplies(id, 1); assert.equal((h.replies(id)[0]!.result as Protocol.DynamicToolCallResponse).success, true); }
+    yield* h.emit(rpc(100)); yield* h.barrier();
+    assert.equal(h.replies(100).length, 1); assert.equal(h.sends(), 32); // completed same-ID tombstone, no cached transport payload
+
+    // Production native child discovery and activeTurns population, not a supplied helper context.
+    yield* h.emit({ method: "item/completed", params: { threadId: rootId, turnId: rootTurn, completedAtMs: 2,
+      item: { type: "subAgentActivity", id: "spawn-child", kind: "started", agentThreadId: "child-native", agentPath: "/root/mock_child" } } });
+    yield* h.emit({ method: "turn/started", params: { threadId: "child-native", turn: turn("child-turn") } });
+    yield* h.waitTurn("child-turn");
+    assert.equal(h.events.some((event) => event.type === "subagent.updated"), true);
+    yield* h.emit(rpc(700, { threadId: "child-native", turnId: "child-turn" }));
+    yield* h.emit(rpc(701, { threadId: rootId, turnId: "child-turn" }));
+    yield* h.emit(rpc(702, { threadId: rootId, turnId: "unknown-turn" }));
+    for (const id of [700, 701, 702]) { yield* h.waitReplies(id, 1); assert.equal((h.replies(id)[0]!.result as Protocol.DynamicToolCallResponse).success, false); }
+    assert.equal(h.sends(), 32);
+
+    // Deferred mocked broker timeout/failure, then replay after the terminal response.
+    // The pure clock tests separately cover the exact shared 10-second deadline.
+    h.phase("fault"); yield* h.emit(rpc(800)); yield* Effect.promise(() => h.faultEntered.promise);
+    yield* h.emit(rpc(800)); yield* h.barrier(); assert.equal(h.replies(800).length, 0);
+    h.fault.reject(new Error("mock broker timeout")); yield* h.waitReplies(800, 1);
+    assert.equal((h.replies(800)[0]!.result as Protocol.DynamicToolCallResponse).success, false);
+    yield* h.emit(rpc(800)); yield* h.barrier(); assert.equal(h.replies(800).length, 1); assert.equal(h.sends(), 33);
+
+    h.phase("shutdown"); yield* h.emit(rpc(900)); yield* Effect.promise(() => h.shutdownEntered.promise);
+    const closing = yield* Scope.close(scope, Exit.void).pipe(Effect.forkScoped);
+    yield* Effect.promise(() => h.closeEntered.promise);
+    yield* h.emit(rpc(900)); // closing connection cannot allocate a replacement operation
+    h.releaseClose.resolve(); yield* Fiber.join(closing);
+    const count = h.replies(900).length;
+    h.hanging.resolve({ private: "late-mock" });
+    for (let i = 0; i < 20; i++) yield* Effect.yieldNow;
+    assert.equal(h.sends(), 34); assert.equal(h.closed(), 1); assert.equal(h.replies(900).length, count);
+    assert.equal(JSON.stringify(h.replies(900)).includes("late-mock"), false);
+  }).pipe(Effect.scoped, Effect.provide(services)),
+);
