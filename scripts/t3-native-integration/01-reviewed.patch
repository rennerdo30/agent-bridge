@@ -0,0 +1,217 @@
+// Proposed upstream file. No broker connection or default production wiring.
+import type * as CodexSchema from "effect-codex-app-server/schema";
+
+export interface BridgeAppScope {
+  readonly appThreadId: string;
+  readonly providerInstanceId: string;
+  readonly providerSessionId: string;
+}
+export interface BridgeRootLease extends BridgeAppScope {
+  readonly nativeThreadId: string;
+}
+export interface BridgeActiveRoot {
+  readonly appThreadId: string;
+  readonly nativeThreadId: string;
+  readonly nativeTurnId: string;
+  readonly isChild: boolean;
+  readonly isCurrent: () => Promise<boolean>;
+}
+type Json = CodexSchema.DynamicToolCallParams["arguments"];
+type Guard = () => Promise<boolean>;
+// The app-owned implementation must pin its broker registration to this scope;
+// it must never reconnect an in-flight operation to a replacement registration.
+// Every method checks guard AND its lease at the actual broker effect boundary.
+// admitMain retains Bridge codexMainThreadAdmission using the trusted native ID.
+export interface BridgeMessagingPort {
+  readonly isLive: () => boolean;
+  readonly admitMain: (lease: BridgeRootLease, signal: AbortSignal) => Promise<boolean>;
+  readonly peers: (lease: BridgeRootLease, guard: Guard, signal: AbortSignal) => Promise<Json>;
+  readonly pending: (lease: BridgeRootLease, guard: Guard, signal: AbortSignal) => Promise<Json>;
+  readonly readMessage: (lease: BridgeRootLease, args: { messageId: string }, guard: Guard, signal: AbortSignal) => Promise<Json>;
+  readonly send: (lease: BridgeRootLease, args: { messageId: string; recipientRef: string; text: string }, guard: Guard, signal: AbortSignal) => Promise<Json>;
+  readonly sendStatus: (lease: BridgeRootLease, args: { messageId: string }, guard: Guard, signal: AbortSignal) => Promise<Json>;
+  // This closes only the captured owned broker registration/connection. The
+  // signal aborts on disposal deadline; it is not the already-aborted call life.
+  readonly close: (signal: AbortSignal) => Promise<void>;
+}
+
+export type BridgeDisposal = { readonly status: "closed" | "failed" | "timedOut" };
+export interface BridgeClock {
+  readonly setTimeout: (callback: () => void, ms: number) => unknown;
+  readonly clearTimeout: (handle: unknown) => void;
+}
+const realClock: BridgeClock = {
+  setTimeout: (callback, ms) => setTimeout(callback, ms),
+  clearTimeout: (handle) => clearTimeout(handle as ReturnType<typeof setTimeout>),
+};
+
+const empty = { type: "object", properties: {}, additionalProperties: false } as const;
+const strings = (names: string[]) => ({
+  type: "object", properties: Object.fromEntries(names.map((name) => [name, { type: "string", minLength: 1 }])),
+  required: names, additionalProperties: false,
+});
+export const bridgeDynamicTools: ReadonlyArray<CodexSchema.ClientRequest__DynamicToolSpec> = [{
+  type: "namespace", name: "agent_bridge", description: "App-owned peer messaging for this root only.",
+  tools: [
+    { type: "function", name: "peers", description: "List permitted peer references.", inputSchema: empty },
+    { type: "function", name: "pending", description: "List pending messages.", inputSchema: empty },
+    { type: "function", name: "read_message", description: "Read a message using existing acknowledgment rules.", inputSchema: strings(["messageId"]) },
+    { type: "function", name: "send", description: "Send text to a permitted peer; never starts or controls tasks.", inputSchema: strings(["messageId", "recipientRef", "text"]) },
+    { type: "function", name: "send_status", description: "Read the outcome of this scope's message ID.", inputSchema: strings(["messageId"]) },
+  ],
+}];
+
+export const bridgeDenied = (): CodexSchema.DynamicToolCallResponse => ({
+  success: false, contentItems: [{ type: "inputText", text: "Bridge messaging unavailable for this call; do not retry automatically." }],
+});
+
+function exactStrings(value: Json, keys: readonly string[]): Record<string, string> | undefined {
+  if (!value || typeof value !== "object" || Array.isArray(value)) return;
+  if (Object.keys(value).length !== keys.length) return;
+  const out: Record<string, string> = {};
+  for (const key of keys) {
+    if (!Object.hasOwn(value, key)) return;
+    const text = value[key as keyof typeof value];
+    if (typeof text !== "string" || text.length === 0 || text.length > 16_384) return;
+    out[key] = text;
+  }
+  return out;
+}
+
+// One instance per owned app-server stdio session; absence of the injected port
+// means no instance, no tool registration, and denied persisted tool requests.
+export function makeBridgeDynamicSession(scope: BridgeAppScope, port: BridgeMessagingPort, options: { readonly clock?: BridgeClock } = {}) {
+  const owner = Object.freeze({ ...scope });
+  const lifetime = new AbortController();
+  const clock = options.clock ?? realClock;
+  let root: BridgeRootLease | undefined;
+  let startReserved = false;
+  let disposal: Promise<BridgeDisposal> | undefined;
+  type Entry = {
+    readonly fingerprint: string;
+    readonly active: BridgeActiveRoot;
+    pending: Promise<void>;
+    response: CodexSchema.DynamicToolCallResponse | undefined;
+  };
+  // No eviction or re-execution: at most 1,024 operations, each with at most
+  // 16,384 response-text characters, retained only in this session generation.
+  const entries = new Map<string, Entry>();
+  const staticAdmission = (lease: BridgeRootLease, call: CodexSchema.DynamicToolCallParams, active: BridgeActiveRoot) =>
+    root === lease && !lifetime.signal.aborted && port.isLive() && !active.isChild &&
+    active.appThreadId === owner.appThreadId && active.nativeThreadId === lease.nativeThreadId &&
+    call.threadId === lease.nativeThreadId && active.nativeTurnId === call.turnId;
+  const current = async (lease: BridgeRootLease, call: CodexSchema.DynamicToolCallParams, active: BridgeActiveRoot) =>
+    staticAdmission(lease, call, active) && await active.isCurrent() && staticAdmission(lease, call, active);
+
+  async function execute(entry: Entry, lease: BridgeRootLease, call: CodexSchema.DynamicToolCallParams, active: BridgeActiveRoot, args: Record<string, string>) {
+    const operation = new AbortController();
+    const combined = AbortSignal.any([lifetime.signal, operation.signal]);
+    const guard = async () => !combined.aborted && await current(lease, call, active) && !combined.aborted;
+    let abortWaiter: () => void = () => {};
+    let timer: unknown;
+    const interrupted = new Promise<CodexSchema.DynamicToolCallResponse>((resolve) => {
+      abortWaiter = () => resolve(bridgeDenied());
+      combined.addEventListener("abort", abortWaiter, { once: true });
+      timer = clock.setTimeout(() => operation.abort(), 10_000);
+    });
+    const work = (async (): Promise<CodexSchema.DynamicToolCallResponse> => {
+      try {
+        if (!await guard() || !await port.admitMain(lease, combined) || !await guard()) return bridgeDenied();
+        let result: Json;
+        switch (call.tool) {
+          case "peers": result = await port.peers(lease, guard, combined); break;
+          case "pending": result = await port.pending(lease, guard, combined); break;
+          case "read_message": result = await port.readMessage(lease, { messageId: args.messageId! }, guard, combined); break;
+          case "send": result = await port.send(lease, { messageId: args.messageId!, recipientRef: args.recipientRef!, text: args.text! }, guard, combined); break;
+          case "send_status": result = await port.sendStatus(lease, { messageId: args.messageId! }, guard, combined); break;
+          default: return bridgeDenied();
+        }
+        if (!await guard()) return bridgeDenied();
+        const text = JSON.stringify(result);
+        if (text === undefined || text.length > 16_384) return bridgeDenied();
+        return Object.freeze({ success: true, contentItems: Object.freeze([Object.freeze({ type: "inputText" as const, text })]) });
+      } catch {
+        // Any uncertain send/read stays settled; no retry against this or a new lease.
+        return bridgeDenied();
+      }
+    })();
+    try {
+      const response = await Promise.race([work, interrupted]);
+      if (staticAdmission(lease, call, active)) entry.response = response;
+    } finally {
+      clock.clearTimeout(timer);
+      combined.removeEventListener("abort", abortWaiter);
+      operation.abort();
+    }
+  }
+  return {
+    // Reserve synchronously before sending start; uncertain registration is not
+    // retried in this session. Another ensureThread cannot acquire this root.
+    reserveStart(): boolean {
+      if (startReserved || lifetime.signal.aborted || !port.isLive()) return false;
+      startReserved = true;
+      return true;
+    },
+    // Invoke only with thread/start's response, never IDs supplied by tools,
+    // native children, thread/resume, or an untrusted transcript/HTTP request.
+    bindStartedRoot(nativeThreadId: string): void {
+      if (!startReserved || lifetime.signal.aborted || !port.isLive() || root || !nativeThreadId) throw new Error("Bridge root cannot be rebound");
+      root = Object.freeze({ ...owner, nativeThreadId });
+    },
+    close(): Promise<BridgeDisposal> {
+      if (disposal) return disposal;
+      // Revoke before any await. Pending operations settle unavailable, and no
+      // cached private response remains reachable through a suspended waiter.
+      lifetime.abort();
+      for (const entry of entries.values()) entry.response = undefined;
+      entries.clear();
+      const closing = new AbortController();
+      disposal = new Promise<BridgeDisposal>((resolve) => {
+        let done = false;
+        const finish = (status: BridgeDisposal["status"]) => {
+          if (done) return;
+          done = true;
+          clock.clearTimeout(timer);
+          resolve(Object.freeze({ status }));
+        };
+        const timer = clock.setTimeout(() => { closing.abort(); finish("timedOut"); }, 2_000);
+        // Catch synchronous throws and promise rejections without logging internals.
+        Promise.resolve().then(() => port.close(closing.signal)).then(
+          () => finish("closed"), () => finish("failed"),
+        );
+      });
+      return disposal;
+    },
+    async dispatch(call: CodexSchema.DynamicToolCallParams, active: BridgeActiveRoot | undefined, signal: AbortSignal): Promise<CodexSchema.DynamicToolCallResponse> {
+      const lease = root;
+      if (!lease || call.namespace !== "agent_bridge" || !call.callId ||
+          call.threadId !== lease.nativeThreadId || lifetime.signal.aborted || !port.isLive()) return bridgeDenied();
+      const keys = call.tool === "peers" || call.tool === "pending" ? [] :
+        call.tool === "read_message" || call.tool === "send_status" ? ["messageId"] :
+        call.tool === "send" ? ["messageId", "recipientRef", "text"] : undefined;
+      const args = keys && exactStrings(call.arguments, keys);
+      if (!args) return bridgeDenied();
+      const key = JSON.stringify([owner.appThreadId, owner.providerInstanceId, owner.providerSessionId, call.threadId, call.turnId, call.callId]);
+      // Current whitelist permits only string-valued fields. Sorted tuples are
+      // an exact canonical representation, independent of input property order.
+      const fingerprint = JSON.stringify([call.namespace, call.tool, Object.entries(args).sort(([a], [b]) => a < b ? -1 : a > b ? 1 : 0)]);
+      let entry = entries.get(key);
+      if (entry) {
+        if (entry.fingerprint !== fingerprint) return bridgeDenied();
+        if (active && !staticAdmission(lease, call, active)) return bridgeDenied();
+      } else {
+        if (!active || !staticAdmission(lease, call, active) || signal.aborted || entries.size >= 1_024) return bridgeDenied();
+        entry = { fingerprint, active, pending: Promise.resolve(), response: undefined };
+        entries.set(key, entry); // Reserve before the first asynchronous admission.
+        entry.pending = execute(entry, lease, call, active, args);
+      }
+      // Request cancellation detaches an Effect waiter, not the shared broker
+      // operation. One session-owned deadline/abort controls every replay.
+      await entry.pending;
+      // Warm replay may precede active-turn reconstruction. It may join only
+      // this exact saved call, and still uses the original authenticated guard.
+      if (!await current(lease, call, entry.active)) return bridgeDenied();
+      return entry.response ?? bridgeDenied();
+    },
+  };
+}
