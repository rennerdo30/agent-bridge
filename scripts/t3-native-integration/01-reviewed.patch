new file mode 100644
index 0000000..4b15f5a
--- /dev/null
+++ b/packages/effect-codex-app-server/src/PrivateRequestAdmission.ts
@@ -0,0 +1,70 @@
+// One instance per private protocol/connection generation. No payload cache.
+import { createHash } from "node:crypto";
+import type { CodexAppServerIncomingRequest } from "./protocol.ts";
+
+export type RequestTicket = { readonly id: string; readonly fingerprint: string; state: "active" | "settled" };
+export type RequestAdmission =
+  | { readonly kind: "accepted"; readonly ticket: RequestTicket }
+  | { readonly kind: "replay" | "conflict" | "overloaded" | "exhausted" | "closed" };
+
+// Incoming JSON has already passed the wire-size cap. Hash sorted JSON members
+// incrementally: never retain request params or private result payloads here.
+function fingerprint(request: CodexAppServerIncomingRequest): string {
+  const hash = createHash("sha256");
+  const visit = (value: unknown, depth: number): void => {
+    if (depth > 128) throw new Error("RPC JSON nesting exceeds admission limit");
+    if (value === null || typeof value !== "object") {
+      const text = JSON.stringify(value);
+      if (text === undefined) throw new Error("RPC value must be JSON");
+      hash.update(text); return;
+    }
+    if (Array.isArray(value)) {
+      hash.update("[");
+      value.forEach((item, index) => { if (index) hash.update(","); visit(item, depth + 1); });
+      hash.update("]"); return;
+    }
+    hash.update("{");
+    Object.keys(value).sort().forEach((key, index) => {
+      if (index) hash.update(",");
+      hash.update(JSON.stringify(key)); hash.update(":");
+      visit((value as Record<string, unknown>)[key], depth + 1);
+    });
+    hash.update("}");
+  };
+  visit({ method: request.method, ...(Object.hasOwn(request, "params") ? { params: request.params } : {}) }, 0);
+  return hash.digest("hex");
+}
+
+export function makePrivateRequestAdmission(maxActive = 32, maxRecords = 1_024) {
+  const records = new Map<string, RequestTicket>();
+  let active = 0;
+  let open = true;
+  return {
+    isOpen: () => open,
+    admit(request: CodexAppServerIncomingRequest): RequestAdmission {
+      if (!open) return { kind: "closed" };
+      if (String(request.id).length > 512) return { kind: "exhausted" };
+      const id = JSON.stringify([typeof request.id, request.id]);
+      let digest: string;
+      try { digest = fingerprint(request); } catch { return { kind: "exhausted" }; }
+      const existing = records.get(id);
+      // Resolve before the cap; duplicate/conflict never creates a fiber or
+      // emits an RPC response which could steal the original's callback.
+      if (existing) return { kind: existing.fingerprint === digest ? "replay" : "conflict" };
+      if (records.size >= maxRecords) return { kind: "exhausted" };
+      const ticket: RequestTicket = { id, fingerprint: digest, state: active >= maxActive ? "settled" : "active" };
+      records.set(id, ticket);
+      if (ticket.state === "settled") return { kind: "overloaded" };
+      active++;
+      return { kind: "accepted", ticket };
+    },
+    finish(ticket: RequestTicket): void {
+      if (!open || records.get(ticket.id) !== ticket || ticket.state !== "active") return;
+      ticket.state = "settled";
+      active--;
+    },
+    close(): void { open = false; records.clear(); active = 0; },
+    // Scalar counters only; diagnostics/tests never expose payloads or results.
+    size: () => ({ active, records: records.size }),
+  };
+}
