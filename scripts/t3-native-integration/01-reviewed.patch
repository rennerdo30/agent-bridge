@@ -0,0 +1,183 @@
+import { it } from "@effect/vitest";
+import assert from "node:assert/strict";
+import type * as Protocol from "effect-codex-app-server/schema";
+import { makeBridgeDynamicSession, type BridgeMessagingPort } from "./CodexBridgeDynamicTools.ts";
+
+const deferred = <T>() => {
+  let resolve!: (value: T) => void;
+  const promise = new Promise<T>((r) => { resolve = r; });
+  return { promise, resolve };
+};
+const flush = async () => { for (let i = 0; i < 12; i++) await Promise.resolve(); };
+function clock() {
+  let id = 0;
+  const jobs = new Map<number, () => void>();
+  return {
+    setTimeout: (callback: () => void, _ms: number) => { jobs.set(++id, callback); return id; },
+    clearTimeout: (handle: unknown) => { jobs.delete(handle as number); },
+    expireAll: () => { for (const [key, job] of [...jobs]) { jobs.delete(key); job(); } },
+    size: () => jobs.size,
+  };
+}
+const scope = { appThreadId: "app-A", providerInstanceId: "provider", providerSessionId: "runtime-A" };
+const active = { appThreadId: "app-A", nativeThreadId: "native-A", nativeTurnId: "turn-A", isChild: false, isCurrent: async () => true };
+const call = (overrides: Partial<Protocol.DynamicToolCallParams> = {}): Protocol.DynamicToolCallParams => ({
+  namespace: "agent_bridge", tool: "send", threadId: "native-A", turnId: "turn-A", callId: "call-A",
+  arguments: { messageId: "m", recipientRef: "r", text: "hello" }, ...overrides,
+});
+function fixture(overrides: Partial<BridgeMessagingPort> = {}) {
+  const timer = clock(); let submissions = 0;
+  const port: BridgeMessagingPort = {
+    isLive: () => true, admitMain: async () => true,
+    peers: async () => [], pending: async () => [], readMessage: async () => ({ text: "mock-private" }),
+    send: async () => { submissions++; return { accepted: "m" }; }, sendStatus: async () => ({ status: "accepted" }),
+    close: async () => {}, ...overrides,
+  };
+  const session = makeBridgeDynamicSession(scope, port, { clock: timer });
+  assert.equal(session.reserveStart(), true); session.bindStartedRoot("native-A");
+  return { session, timer, submissions: () => submissions };
+}
+const signal = () => new AbortController().signal;
+
+it("coalesces canonical-equivalent replay during real suspension without early settlement", async () => {
+  const entered = deferred<void>(), release = deferred<Protocol.DynamicToolCallParams["arguments"]>();
+  let effects = 0;
+  const f = fixture({ send: async () => { effects++; entered.resolve(); return release.promise; } });
+  const first = f.session.dispatch(call(), active, signal());
+  await entered.promise;
+  let replaySettled = false;
+  const replay = f.session.dispatch(call({ arguments: { text: "hello", recipientRef: "r", messageId: "m" } }), active, signal()).then((value) => { replaySettled = true; return value; });
+  try { await flush(); assert.equal(replaySettled, false, "replay must await original suspended effect"); }
+  finally { release.resolve({ accepted: "m" }); }
+  assert.deepEqual(await replay, await first); assert.equal(effects, 1);
+});
+
