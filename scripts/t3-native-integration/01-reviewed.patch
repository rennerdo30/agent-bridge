+
+it("send forwards only explicit messaging arguments to its pinned app port", async () => {
+  const args = { messageId: "stable-id", recipientRef: "server-issued-peer", text: "hello" };
+  let submitted = 0;
+  const f = fixture("A", { send: async (lease, received, guard, abort) => {
+    assert.equal(await guard(), true); assert.equal(abort.aborted, false);
+    assert.equal(lease.appThreadId, "app-A"); assert.deepEqual(received, args);
+    submitted++; return { messageId: received.messageId, state: "accepted" };
+  } });
+  f.bind("native-A");
+  assert.equal((await f.session.dispatch(call({ tool: "send", arguments: args }), active(), signal())).success, true);
+  assert.equal((await f.session.dispatch(call({ callId: "bad", tool: "send", arguments: { ...args, frontend: "other" } }), active(), signal())).success, false);
+  assert.equal(submitted, 1);
