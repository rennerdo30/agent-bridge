diff --git a/packages/effect-codex-app-server/src/PrivateProtocolLifecycle.test.ts b/packages/effect-codex-app-server/src/PrivateProtocolLifecycle.test.ts
new file mode 100644
index 0000000..0da6130
--- /dev/null
+++ b/packages/effect-codex-app-server/src/PrivateProtocolLifecycle.test.ts
@@ -0,0 +1,144 @@
+import { assert, it } from "@effect/vitest";
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import * as Deferred from "effect/Deferred";
+import * as Effect from "effect/Effect";
+import * as Fiber from "effect/Fiber";
+import * as Queue from "effect/Queue";
+import * as Sink from "effect/Sink";
+import * as Stdio from "effect/Stdio";
+import * as Stream from "effect/Stream";
+import * as CodexError from "./errors.ts";
+import * as Protocol from "./protocol.ts";
+import { makeInMemoryStdio } from "./_internal/stdio.ts";
+
+const encode = (value: unknown) => new TextEncoder().encode(`${JSON.stringify(value)}\n`);
+const request = { id: 7, method: "item/tool/call", params: { mock: true } };
+
+it.layer(NodeServices.layer)("AB458 real protocol lifecycle", (it) => {
+  it.effect.each(["writer", "defect-before", "defect-after", "throw-before"] as const)(
+    "terminalizes unknown outcome %s without replay or fresh admission",
+    (failureKind) => Effect.gen(function* () {
+      const pipe = yield* makeInMemoryStdio();
+      const terminated = yield* Deferred.make<CodexError.CodexAppServerError>();
+      const readerStopped = yield* Deferred.make<void>();
+      const committed = yield* Deferred.make<void>();
+      let effects = 0, admissions = 0, writes = 0, terminations = 0;
+      const stdio = Stdio.make({
+        args: pipe.stdio.args,
+        stdin: pipe.stdio.stdin.pipe(Stream.ensuring(
+          Deferred.succeed(readerStopped, undefined).pipe(Effect.asVoid),
+        )),
+        stdout: () => Sink.forEach((chunk: string | Uint8Array) => {
+          const text = typeof chunk === "string" ? chunk : new TextDecoder().decode(chunk);
+          const frame = JSON.parse(text) as Record<string, unknown>;
+          if (failureKind === "writer" && frame.id === 7) {
+            writes++;
+            return Effect.die(new Error("mock owned writer failure after effect"));
+          }
+          return Queue.offer(pipe.output, text).pipe(Effect.asVoid);
+        }),
+        stderr: pipe.stdio.stderr,
+      });
+      const transport = yield* Protocol.makeCodexAppServerPatchedProtocol({
+        stdio,
+        onRequest: () => {
+          admissions++;
+          if (failureKind === "throw-before") throw new Error("mock callback construction defect");
+          if (failureKind === "defect-before") return Effect.die(new Error("mock handler defect"));
+          return Effect.sync(() => effects++).pipe(
+            Effect.andThen(Deferred.succeed(committed, undefined)),
+            Effect.andThen(failureKind === "defect-after"
+              ? Effect.die(new Error("mock defect after commit"))
+              : Effect.succeed({ committed: true })),
+          );
+        },
+        onTermination: (error) => Effect.sync(() => terminations++).pipe(
+          Effect.andThen(Deferred.succeed(terminated, error)), Effect.asVoid,
+        ),
+      });
+      const pending = yield* transport.request("thread/read", {}).pipe(Effect.forkScoped);
+      yield* Queue.take(pipe.output);
+      yield* Queue.offer(pipe.input, encode(request));
+      if (failureKind === "writer" || failureKind === "defect-after") yield* Deferred.await(committed);
+      const failure = yield* Deferred.await(terminated).pipe(Effect.timeout("2 seconds"));
+      assert.instanceOf(failure, CodexError.CodexAppServerTransportError, "AB458_TERMINAL_CAUSE");
+      if (failure instanceof CodexError.CodexAppServerTransportError) {
+        assert.equal(failure.operation, failureKind === "writer" ? "write-output-stream" : "handle-server-request");
+      }
+      assert.strictEqual(yield* Fiber.join(pending).pipe(Effect.flip), failure);
+      yield* Deferred.await(readerStopped).pipe(Effect.timeout("2 seconds"));
+      yield* Queue.offer(pipe.input, encode(request));
+      yield* Queue.offer(pipe.input, encode({ ...request, id: 8 }));
+      assert.strictEqual(yield* transport.request("thread/read", {}).pipe(Effect.flip), failure);
+      assert.strictEqual(yield* transport.notify("initialized").pipe(Effect.flip), failure);
+      assert.equal(admissions, 1, "AB458_NO_REEXECUTION");
+      assert.equal(effects, failureKind === "writer" || failureKind === "defect-after" ? 1 : 0);
+      assert.equal(writes, failureKind === "writer" ? 1 : 0);
+      assert.equal(terminations, 1);
+      assert.equal(yield* Queue.size(pipe.input), 2);
+    }),
+  );
+
+  it.effect("preserves non-Bridge managed typed errors and subsequent approvals", () =>
+    Effect.gen(function* () {
+      const pipe = yield* makeInMemoryStdio();
+      let count = 0, terminated = 0;
+      yield* Protocol.makeCodexAppServerPatchedProtocol({
+        stdio: pipe.stdio,
+        onRequest: () => ++count === 1
+          ? Effect.fail(CodexError.CodexAppServerRequestError.overloaded("mock recoverable"))
+          : Effect.succeed({ decision: "accept" }),
+        onTermination: () => Effect.sync(() => { terminated++; }),
+      });
+      yield* Queue.offer(pipe.input, encode({ id: "approval-A", method: "item/tool/requestUserInput", params: {} }));
+      assert.deepEqual(JSON.parse(yield* Queue.take(pipe.output)), {
+        id: "approval-A", error: { code: -32001, message: "mock recoverable" },
+      });
+      yield* Queue.offer(pipe.input, encode({ id: "approval-B", method: "item/tool/requestUserInput", params: {} }));
+      assert.deepEqual(JSON.parse(yield* Queue.take(pipe.output)), { id: "approval-B", result: { decision: "accept" } });
+      assert.equal(count, 2); assert.equal(terminated, 0);
+    }),
+  );
+
+  it.effect("fails closed before handler admission on an exhausted request fingerprint budget", () =>
+    Effect.gen(function* () {
+      const pipe = yield* makeInMemoryStdio();
+      const terminated = yield* Deferred.make<CodexError.CodexAppServerError>();
+      let admissions = 0;
+      const transport = yield* Protocol.makeCodexAppServerPatchedProtocol({
+        stdio: pipe.stdio,
+        onRequest: () => Effect.sync(() => { admissions++; return {}; }),
+        onTermination: (error) => Deferred.succeed(terminated, error).pipe(Effect.asVoid),
+      });
+      let nested: unknown = null;
+      for (let index = 0; index < 130; index++) nested = [nested];
+      yield* Queue.offer(pipe.input, encode({ ...request, params: nested }));
+      const failure = yield* Deferred.await(terminated).pipe(Effect.timeout("2 seconds"));
+      assert.instanceOf(failure, CodexError.CodexAppServerTransportError);
+      assert.equal(admissions, 0);
+      assert.strictEqual(yield* transport.notify("initialized").pipe(Effect.flip), failure);
+    }),
+  );
+
+  it.effect("classifies shutdown cancellation separately from defects and interrupts owned handlers", () =>
+    Effect.gen(function* () {
+      const pipe = yield* makeInMemoryStdio();
+      const started = yield* Deferred.make<void>(), interrupted = yield* Deferred.make<void>();
+      const terminated = yield* Deferred.make<CodexError.CodexAppServerError>();
+      const transport = yield* Protocol.makeCodexAppServerPatchedProtocol({
+        stdio: pipe.stdio,
+        onRequest: () => Deferred.succeed(started, undefined).pipe(
+          Effect.andThen(Effect.never),
+          Effect.onInterrupt(() => Deferred.succeed(interrupted, undefined).pipe(Effect.asVoid)),
+        ),
+        onTermination: (error) => Deferred.succeed(terminated, error).pipe(Effect.asVoid),
+      });
+      yield* Queue.offer(pipe.input, encode(request)); yield* Deferred.await(started);
+      yield* Queue.end(pipe.input);
+      const failure = yield* Deferred.await(terminated).pipe(Effect.timeout("2 seconds"));
+      assert.instanceOf(failure, CodexError.CodexAppServerInputStreamEndedError);
+      yield* Deferred.await(interrupted).pipe(Effect.timeout("2 seconds"));
+      assert.strictEqual(yield* transport.notify("initialized").pipe(Effect.flip), failure);
+    }),
+  );
+});
